# Copie para .env e escolha senhas locais; scripts/iniciar-banco.ps1 pode gerá-las.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
AUTH_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_LOGIN_WINDOW=15m
AUTH_RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTRATION_WINDOW=1h

# Somente desenvolvimento HTTP local. No site HTTPS, manter true.
SESSION_COOKIE_SECURE=false

# Contas de teste para avaliação e Postman (admin@skillswap.dev, profissional@ e cliente@skillswap.dev).
# Localmente o iniciar-backend.ps1 ativa por padrão. No site publicado, use senhas próprias
# e informe o acesso somente na entrega do AVA.
DEMO_USERS_ENABLED=true
DEMO_ADMIN_PASSWORD=Admin@Teste2026
DEMO_USER_PASSWORD=Usuario@Teste2026
# E-mails com perfil ADMIN (moderação), separados por vírgula.
MODERATOR_EMAILS=
